# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test scratch space (kept inside the repo for sandboxed runs)
.pytest_tmp/
.pytest_cache/

# Assistant workspace state - not part of the project
.workbuddy-ai/

# ---------------------------------------------------------------------------
# Competition data - NEVER publish
# ---------------------------------------------------------------------------
# The dataset is provided by the organiser under the competition's terms.
# Redistributing it (especially the B-board test images) would breach those
# terms, and the archives are hundreds of MB on top. Download it from the
# official page instead; manifests and fold splits are regenerated with
# `make data` / `make split`.
data/

# ---------------------------------------------------------------------------
# Trained artefacts and submission packages - NEVER publish
# ---------------------------------------------------------------------------
# One checkpoint is 351 MB (over GitHub's 100 MB per-file limit) and each
# packed solution.zip is ~1.6 GB. They belong in the post-competition review
# channel, not in a public repository.
outputs/
solution/model/*.pt

# ---------------------------------------------------------------------------
# The organiser's own scripts - NOT ours to redistribute
# ---------------------------------------------------------------------------
# src/eval/official_oracle/ and src/submit/official/ hold byte-for-byte copies
# of the scorer/validator shipped in the official submission kit. They are
# third-party code, so they stay out of a public repo; copy them back from the
# kit to re-run the freeze tests (`src/official_freeze.json` records the SHA-256
# each one must have).
src/eval/official_oracle/
src/submit/official/

# Artefacts belonging to a different (abandoned) competition
archive/classification_berry/leftover_submissions/

# OS
.DS_Store
